{
    "name": "amactech/mini-framework",
    "description": "Base MVC reutilizável em PHP puro, com roteamento, PDO, segurança e testes.",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.1",
        "vlucas/phpdotenv": "^5.6"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit --colors=always",
        "lint": "@php tools/lint.php"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
